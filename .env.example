# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_service_role_key

# Owner Bootstrap Secret (required for initial OWNER creation)
OWNER_BOOTSTRAP_SECRET=generate_a_secure_random_string_here

# CORS Origins (comma-separated, no spaces)
# Example: https://your-frontend.com,https://admin.your-frontend.com
CORS_ORIGINS=

# Server Configuration
PORT=3000
NODE_ENV=production

# Optional: Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Optional: Logging
LOG_LEVEL=info
